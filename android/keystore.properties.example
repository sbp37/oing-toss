# 이 파일을 keystore.properties로 복사해서 값을 채운다.
# keystore.properties는 .gitignore에 있으니 저장소에 올라가지 않는다.
# 비밀번호를 이 파일에 두기 싫으면 대신 환경변수를 쓰면 된다:
#   OING_KEYSTORE_FILE / OING_KEYSTORE_PASSWORD / OING_KEY_ALIAS / OING_KEY_PASSWORD

# 키스토어 파일의 절대 경로 (저장소 밖에 두는 것을 권장)
storeFile=/절대/경로/oing-upload.jks
storePassword=
keyAlias=oing-upload
keyPassword=
