{
  "name": "oing-toss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node hosting/build-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "balance": "node scripts/simulate-balance.mjs",
    "balance:stress": "node scripts/stress-balance.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:aab": "npm run android:sync && node tools/gradle.mjs bundleRelease",
    "android:apk": "npm run android:sync && node tools/gradle.mjs assembleRelease",
    "build:ait": "node hosting/build-static.mjs --ait",
    "ait": "node tools/build-ait.mjs"
  },
  "devDependencies": {
    "@apps-in-toss/web-framework": "^3.1.1",
    "@capacitor/cli": "^8.5.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@neondatabase/serverless": "^1.1.0"
  }
}
